        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>CBCMDERR</name>
              <description>The checked area by the check blank command is all 0xFF or not.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
